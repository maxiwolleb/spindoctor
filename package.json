{
  "name": "spindoctor",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22", "pnpm": ">=9" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "spellcheck": "cspell --no-progress \"apps/**\" \"packages/**\" \"website/**\" \".github/**\" \"*.md\" \"*.json\" \"*.yml\" \"*.yaml\" \"Dockerfile\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm --filter @spindoctor/shared run typecheck && pnpm --filter @spindoctor/backend --if-present run build && pnpm --filter @spindoctor/web run build",
    "dev": "pnpm --parallel --filter @spindoctor/backend --filter @spindoctor/web run dev"
  },
  "devDependencies": {
    "@types/node": "^22",
    "cspell": "^10.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
