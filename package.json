{
  "name": "spindoctor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "spellcheck": "cspell --no-progress \"apps/**\" \"packages/**\" \"website/**\" \".github/**\" \"*.md\" \"*.json\" \"*.yml\" \"*.yaml\" \"Dockerfile\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip --no-progress",
    "format": "prettier --write apps packages website .github README.md CONTRIBUTING.md CODE_OF_CONDUCT.md \"*.json\" \"*.yml\" \"*.yaml\" \"*.mjs\" \"*.ts\"",
    "format:check": "prettier --check apps packages website .github README.md CONTRIBUTING.md CODE_OF_CONDUCT.md \"*.json\" \"*.yml\" \"*.yaml\" \"*.mjs\" \"*.ts\"",
    "build": "pnpm --filter @spindoctor/shared run typecheck && pnpm --filter @spindoctor/backend --if-present run build && pnpm --filter @spindoctor/web run build",
    "dev": "pnpm --parallel --filter @spindoctor/backend --filter @spindoctor/web run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
